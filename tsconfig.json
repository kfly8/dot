{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "jsxImportSource": "@barefootjs/hono/jsx",
    "types": ["bun", "node"], "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "noEmit": true
  },
  "include": ["**/*.ts", "**/*.tsx"], "exclude": ["node_modules", "dist"]
}
